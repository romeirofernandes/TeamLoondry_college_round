{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable",
      "WebWorker"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "vite/client",
      "node"
    ],
    "paths": {
      "@mediapipe/tasks-vision": [
        "./node_modules/@mediapipe/tasks-vision"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts"
  ]
}
